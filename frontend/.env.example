# Frontend runtime config.
# Copy to `.env.local` (gitignored) and fill in the real values before `npm run dev`.

# Base URL of the FastAPI backend (RunPod Pod HTTPS URL, or local :8000 for dev).
# When blank, the app falls back to same-origin requests via the Vite dev proxy.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Supabase client config used by the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Must match the API_KEY env var on the backend. Leave empty for local dev
# when the server runs without auth.
VITE_API_KEY=

# Vercel SERVER environment only: enable after configuring providers and
# verifying real code delivery. Do not prefix these with VITE_.
AUTH_EMAIL_OTP_ENABLED=false
AUTH_PHONE_OTP_ENABLED=false

# Supabase Send SMS HTTP hook -> https://www.aifootnova.com/api/auth-sms-hook
# Server secrets only. OTP length must be 6. Each template takes one code parameter.
AUTH_SMS_HOOK_SECRET=
AUTH_SMS_ALLOWED_PREFIXES=+86,+64,+61
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_APP_ID=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_TEMPLATE_CN=
TENCENT_SMS_SIGN_CN=
TENCENT_SMS_TEMPLATE_INTL=
TENCENT_SMS_SIGN_INTL=
TENCENT_SMS_SENDER_ID=
